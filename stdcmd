import sys

CMD = "stdcmd"


def process(line):
    """入力1行を処理して, 出力する文字列を返す.

    不正な入力に対しては ValueError を送出する.
    TODO: ここにコマンド本来の処理を実装する(現在は入力をそのまま返す).
    """
    return line


def error(msg):
    """人に向けたメッセージは標準エラー出力に出す."""
    print(f"{CMD}: {msg}", file=sys.stderr)


def main():
    status = 0
    for n, line in enumerate(sys.stdin, start=1):
        line = line.rstrip("\n")
        try:
            print(process(line))
        except ValueError as e:
            error(f"line {n}: {e}")
            status = 1
    return status


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.stderr.close()
        sys.exit(1)
